# Where the Musafir backend lives. Server-side only, the browser never sees
# it, because every call goes through this site's own /api/* route handlers.
# The port Next serves on. PM2 reads it from here.
PORT=8013

API_URL=http://127.0.0.1:5013

# Fallbacks for the header, the footer and the WhatsApp links, used ONLY when
# the backend is unreachable.
#
# The real values come from Settings in the office, so a phone number changes
# in one place. Leave these blank unless you want a last-known-good number to
# survive a backend restart: anything written here is printed as though it were
# real, and a customer who dials a placeholder reaches a stranger.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=hello@musafircars.com
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_SITE_URL=https://musafircars.com
