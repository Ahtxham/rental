# Where the Musafir backend lives. Server-side only, the browser never sees
# it, because every call goes through this site's own /api/* route handlers.
API_URL=http://localhost:5012

# Fallbacks for the header, the footer and the WhatsApp links.
#
# The real values come from the backend (Settings in the office), so a phone
# number changes in one place. These render only when the API is unreachable,
# a rental site whose number disappears because the backend restarted is worse
# than one showing a number a week out of date.
NEXT_PUBLIC_CONTACT_PHONE=+92 300 0000000
NEXT_PUBLIC_CONTACT_WHATSAPP=923000000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@musafircars.com
NEXT_PUBLIC_CONTACT_ADDRESS=Lahore, Pakistan
NEXT_PUBLIC_SITE_URL=https://musafircars.com
