# ── Server ────────────────────────────────────────────────────────────────
# Port the Express server listens on
PORT=5013
# development | production, controls error verbosity
MODE=development
# Comma-separated CORS origins. The website talks to this API from its own
# server, not the browser, so this is mostly for local tooling.
ALLOWED_ORIGINS=https://musafircars.com,https://www.musafircars.com

# ── Database ──────────────────────────────────────────────────────────────
DB_URI=mongodb://localhost:27017/musafir

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED. At least 32 characters, the server refuses to boot otherwise.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── musafircars.com ───────────────────────────────────────────────────────
# The business whose cars the public site publishes.
#
# The public endpoints have no account and no token behind them, so the
# business cannot come from the request. Unset means the public site is simply
# OFF and every one of those routes answers 404, a rental site that lists the
# wrong cars is worse than one that is down.
#
# `yarn seed:agency` prints the id to put here.
PUBLIC_AGENCY_ID=

# ── Redis (optional) ──────────────────────────────────────────────────────
# Distributed rate limiting and multi-instance Socket.IO. Empty is fine locally.
REDIS_URL=

# ── AWS S3 uploads (optional) ─────────────────────────────────────────────
# When unset, uploads are stored on local disk under backend/uploads/
AWS_REGION=
AWS_ACCESSKEYID=
AWS_SECRETACCESSKEY=
AWS_BUCKET_NAME=

# ── Daily DB backup → S3 (optional) ───────────────────────────────────────
# Runs in-process. Skipped entirely when no bucket is configured.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/musafir
BACKUP_CRON=0 0 * * *
BACKUP_TZ=Asia/Karachi
BACKUP_KEEP=30

# ── Push notifications, OneSignal (optional) ──────────────────────────────
# Unset leaves push disabled and every send a logged no-op. The bell in the
# admin still works, the record is written either way.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# Set to "Basic" only if the dashboard gave you a legacy (pre-2024) REST key.
ONESIGNAL_AUTH_SCHEME=Key

# ── Bootstrap (yarn seed:agency) ──────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=
AGENCY_NAME=Musafir Rent A Car
AGENCY_CITY=Lahore
AGENCY_PHONE=
AGENCY_WHATSAPP=
AGENCY_EMAIL=hello@musafircars.com
