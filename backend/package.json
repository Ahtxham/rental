{
  "name": "musafir-backend",
  "version": "1.0.0",
  "description": "Musafir Rent A Car \u2014 Express + TypeScript + MongoDB backend",
  "main": "src",
  "scripts": {
    "start": "yarn build && node dist/index.js",
    "dev": "nodemon",
    "build": "tsc",
    "seed:agency": "ts-node -r tsconfig-paths/register scripts/seed-agency.ts",
    "lintFix": "npx eslint \"src/**/*.{ts,js}\" --fix",
    "format": "npx prettier --write \"src/**/*.{ts,js,json,md}\"",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "seed:demo": "ts-node -r tsconfig-paths/register scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17",
    "express": "^5",
    "express-rate-limit": "^8",
    "express-validator": "^7.2.1",
    "helmet": "^8",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "mongoose": "^9",
    "morgan": "^1.10.0",
    "multer": "^2",
    "node-cron": "^4.6.0",
    "rate-limit-redis": "^6",
    "socket.io": "^4.8.3",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "license": "ISC",
  "resolutions": {
    "nodemon/**/brace-expansion": "^5.0.9"
  }
}
